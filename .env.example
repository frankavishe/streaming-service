# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Postgres ---
POSTGRES_USER=streaming
POSTGRES_PASSWORD=streaming
POSTGRES_DB=streaming
DATABASE_URL=postgresql://streaming:streaming@postgres:5432/streaming?schema=public

# --- Redis (BullMQ transcode queue + short-lived cache) ---
REDIS_URL=redis://redis:6379

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=streaming-media
S3_FORCE_PATH_STYLE=true
# Public-facing endpoint used when *signing* URLs handed to browsers (may differ from the
# in-network S3_ENDPOINT above, e.g. http://localhost:9000 in local dev).
S3_PUBLIC_ENDPOINT=http://localhost:9000

# --- Auth / JWT ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=30d

# --- Seed admin (used by prisma/seed.ts on first run) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- Subscription plan ---
SUBSCRIPTION_PERIOD_DAYS=30
SUBSCRIPTION_PRICE_AMOUNT=999
SUBSCRIPTION_CURRENCY=KES

# --- M-Pesa Daraja (STK Push) sandbox credentials ---
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://<public-host>/api/payments/mpesa/callback?token=change-me-callback-token
# Shared secret carried as a query string on the registered callback URL above, since Daraja has
# no native webhook-signature header (Constitution Principle II). Must match the token in the URL.
MPESA_CALLBACK_TOKEN=change-me-callback-token
MPESA_STK_TIMEOUT_SECONDS=120

# --- Flutterwave (bank/card gateway) ---
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=change-me-webhook-secret-hash
FLUTTERWAVE_REDIRECT_URL=https://<public-host>/account/subscribe/return

# --- Frontend ---
# Browser-facing URL (used client-side).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
# Server-side (SSR, inside the frontend container) must use the Docker network hostname instead —
# set directly in docker-compose.yml's frontend service, not usually needed here.
# API_INTERNAL_BASE_URL=http://backend-api:3001/api
NODE_ENV=development
